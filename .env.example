# ═══════════════════════════════════════════════════
# METRIC — Configuration (`API-02`)
# ═══════════════════════════════════════════════════
# Copier en `.env` à la racine, puis renseigner. Aucun secret ne doit apparaître
# ailleurs : ni dans le code, ni côté client, ni dans un CSV.
#
#   cp .env.example .env
#
# Toutes les valeurs ci-dessous ont un repli qui permet à l'application de démarrer
# sans configuration. Ce qui n'est pas configuré est annoncé comme indisponible —
# jamais deviné, jamais simulé.

# ── Service ────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# Fuseau de découpage des journées (`HEAT-32`). Jamais UTC : une prise à 23 h 30
# appartient au jour affiché par l'horloge, pas au lendemain.
TIMEZONE=Europe/Paris

# ── Stockage Nextcloud / WebDAV (`STO-01`) ─────────
# Le backend est le seul détenteur de ces identifiants.
# Utiliser un mot de passe d'application Nextcloud, pas le mot de passe du compte.
# Vérifier la configuration avant de lancer l'API : `make check-storage` (lot L01).
NEXTCLOUD_URL=https://nextcloud.exemple.fr/remote.php/dav/files/aleksi
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=
# Dossier racine des données, sous le répertoire de l'utilisateur.
NEXTCLOUD_ROOT=Metric

# ── Authentification (`AUTH-01` → `AUTH-03`) ───────
AUTH_USERNAME=aleksi
# Hash Argon2id — jamais de mot de passe en clair (`AUTH-02`).
# Générer avec : `make hash-password` (lot L02, `AUTH-08`).
AUTH_PASSWORD_HASH=

# Signature des jetons de session. Générer une valeur longue et unique :
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_TTL_DAYS=7

# ── CORS (`API-03`) ────────────────────────────────
# Origines autorisées, séparées par des virgules. Dev local + domaine de production.
CORS_ORIGINS=http://localhost:5173

# ── IA OpenRouter (`IA-01`, `IA-07`) ───────────────
# Facultatif. Sans clé, l'application fonctionne intégralement en saisie manuelle et
# les fonctions IA renvoient un message clair. L'IA est un confort, jamais un prérequis.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modèle préféré ; vide = découverte automatique des modèles gratuits (`IA-02`).
OPENROUTER_MODEL=

# ── Export iCal (`PLAN-05`) ────────────────────────
# Clé du flux `.ics` abonnable. Stable : la changer casse les abonnements existants.
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ICAL_SECRET=
